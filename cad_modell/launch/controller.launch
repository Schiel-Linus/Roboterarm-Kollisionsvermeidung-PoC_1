<launch>

<rosparam file="$(find poc_1_only_cad_step_03_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="poc_1_only_cad_step_03" args="Umdrehung 1_position_controller Umdrehung 2_position_controller Umdrehung 3_position_controller Umdrehung 4_position_controller Umdrehung 5_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/poc_1_only_cad_step_03/joint_states"/>
</node>

</launch>